# Prevent accidentally nested project copies
**/node_modules/
# Dependencies
node_modules/
server/node_modules/
web/node_modules/
mobile/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build output
dist/
web/dist/
server/dist/

# Local SQLite database
server/prisma/dev.db
server/prisma/dev.db-journal

# Expo / React Native
.expo/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
# Editor settings
.cursor/

# Local database backups
server/prisma/*.db
server/prisma/*.db-journal
